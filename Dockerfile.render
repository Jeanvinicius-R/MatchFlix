# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# MatchFlix no Render (render.yaml). Diferente do Dockerfile da raiz (LAN), esta
# imagem aplica as migrations pendentes (`prisma migrate deploy`) ANTES de subir
# o servidor — no plano grátis do Render não existe "pre-deploy command", e sem
# isso o banco novo ficaria sem tabelas. `migrate deploy` só aplica migrations
# versionadas já commitadas; nunca gera, reseta nem apaga dados.
#
# Imagem única (inclui node_modules para o Prisma CLI), então é maior que a da LAN.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# Prisma precisa do OpenSSL para escolher o engine certo.
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma7.config.ts ./
RUN npm ci

COPY . .

# DATABASE_URL só precisa EXISTIR durante o build (src/lib/prisma.ts lança erro
# sem ela). É passada só nestes comandos, para não ficar gravada na imagem — em
# runtime vale a URL real do Render.
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" npx prisma generate \
  && DATABASE_URL="postgresql://build:build@localhost:5432/build" npm run build \
  && cp -r .next/static .next/standalone/.next/static

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    MEDIA_UPLOAD_DIR=/app/uploads \
    HOME=/tmp \
    CHECKPOINT_DISABLE=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=1

# Usuário sem privilégios; /app/uploads é o storage LOCAL (efêmero no plano grátis).
RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs \
  && mkdir -p /app/uploads \
  && chown nextjs:nodejs /app/uploads

USER nextjs
EXPOSE 3000

# 1) migrations pendentes (se falhar, o deploy falha em vez de subir com banco quebrado)
# 2) servidor standalone do Next
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && cd .next/standalone && exec node server.js"]
