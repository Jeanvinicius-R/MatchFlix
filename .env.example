# ---------------------------------------------------------------------------
# MatchFlix — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores. Nunca commite ".env".
# ---------------------------------------------------------------------------

# Metadados públicos do site (seguros para expor ao navegador).
NEXT_PUBLIC_APP_NAME="MatchFlix"

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL, via Prisma).
# Valor abaixo corresponde ao serviço "postgres" do docker-compose.yml.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://aurel:aurel@localhost:5432/aurel?schema=public"

# ---------------------------------------------------------------------------
# TMDB (The Movie Database) — fonte externa de metadados de filmes/séries
# (título, sinopse, pôsteres, backdrops, gêneros, classificação, temporadas
# e episódios). NÃO é usada para armazenar ou servir os arquivos de vídeo.
#
# Crie uma conta gratuita em https://www.themoviedb.org/signup, peça uma
# chave de API em Configurações → API, e copie o "API Read Access Token"
# (o token longo — não a "API Key" curta).
#
# Este token é lido apenas em código server-side (src/services/tmdb/*).
# NUNCA prefixe com NEXT_PUBLIC_ — isso o exporia ao navegador.
# ---------------------------------------------------------------------------
TMDB_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Autenticação (Auth.js / NextAuth v5).
# Gere um valor com: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# As variáveis abaixo serão adicionadas em etapas futuras
# (storage de mídia) e estão aqui apenas como referência do que vem a
# seguir — não são necessárias ainda.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Auth.js em produção (npm run start) ou acessando por outro endereço (IP da
# rede, domínio): sem isto o login falha com "UntrustedHost". Como o app é
# hospedado por você, confie no host da requisição. Se preferir travar em um
# endereço fixo, use AUTH_URL="https://seu-dominio" no lugar.
# ---------------------------------------------------------------------------
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Pasta com os SEUS arquivos de vídeo ("Meus arquivos"). Use barras normais.
# Nomeie como "Título (Ano).mp4" — veja o LEIA-ME.txt dentro da pasta.
# ---------------------------------------------------------------------------
MEDIA_LIBRARY_DIR="D:/movies"
