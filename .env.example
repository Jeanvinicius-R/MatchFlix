# ---------------------------------------------------------------------------
# MatchFlix — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores. Nunca commite ".env".
# ---------------------------------------------------------------------------

# Metadados públicos do site (seguros para expor ao navegador).
NEXT_PUBLIC_APP_NAME="MatchFlix"

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL, via Prisma).
# Valor abaixo corresponde ao serviço "postgres" do docker-compose.yml.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://aurel:aurel@localhost:5432/aurel?schema=public"

# Opcional, só para o Neon: "neon-ws" conecta por WebSocket (porta 443) em vez
# da porta 5432 — use em redes que bloqueiam o Postgres (ex.: rede da escola).
# Vazio = conexão Postgres normal.
DATABASE_DRIVER=

# ---------------------------------------------------------------------------
# TMDB (The Movie Database) — fonte externa de metadados de filmes/séries
# (título, sinopse, pôsteres, backdrops, gêneros, classificação, temporadas
# e episódios). NÃO é usada para armazenar ou servir os arquivos de vídeo.
#
# Crie uma conta gratuita em https://www.themoviedb.org/signup, peça uma
# chave de API em Configurações → API, e copie o "API Read Access Token"
# (o token longo — não a "API Key" curta).
#
# Este token é lido apenas em código server-side (src/services/tmdb/*).
# NUNCA prefixe com NEXT_PUBLIC_ — isso o exporia ao navegador.
# ---------------------------------------------------------------------------
TMDB_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Autenticação (Auth.js / NextAuth v5).
# Gere um valor com: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Auth.js em produção (npm run start) ou acessando por outro endereço (IP da
# rede, domínio): sem isto o login falha com "UntrustedHost". Como o app é
# hospedado por você, confie no host da requisição. Se preferir travar em um
# endereço fixo, use AUTH_URL="https://seu-dominio" no lugar.
# ---------------------------------------------------------------------------
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Primeiro administrador sem mexer no banco (útil no Render): quem se
# cadastrar com este e-mail vira ADMIN — somente enquanto não existir nenhum
# admin. O e-mail não é verificado: cadastre a conta logo após o deploy.
# Vazio = ninguém é promovido automaticamente.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Pasta com os SEUS arquivos de vídeo ("Meus arquivos"). Use barras normais.
# Nomeie como "Título (Ano).mp4". Vazio = pasta "movies" na raiz do projeto.
# ---------------------------------------------------------------------------
MEDIA_LIBRARY_DIR=

# ---------------------------------------------------------------------------
# Uploads do painel e dos perfis (pôster, banner, avatar, vídeo) — storage
# LOCAL em disco. Vazio = pasta "uploads" na raiz do projeto (fora do Git).
# No Render (plano grátis) o disco é apagado a cada deploy: uploads não
# persistem lá sem um disco persistente.
# ---------------------------------------------------------------------------
MEDIA_UPLOAD_DIR=

# Limite de tamanho de cada vídeo enviado, em MB. Vazio = 2048.
MEDIA_UPLOAD_MAX_VIDEO_MB=

# ---------------------------------------------------------------------------
# Fonte de vídeo que VOCÊ tem autorização para usar. Vazio = desativada.
# Filme: ${BASE}/movie/<tmdbId> · Série: ${BASE}/tv/<tmdbId>/<temporada>/<episódio>
# Só http(s). Não configure serviços sem licença.
# ---------------------------------------------------------------------------
PLAYBACK_AUTHORIZED_BASE_URL=

# ---------------------------------------------------------------------------
# YouTube Data API v3 (chave de API do Google Cloud). Lida só no servidor —
# NUNCA prefixe com NEXT_PUBLIC_. Vazio = provider do YouTube desativado.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Canais do YouTube cujos vídeos o provider pode aceitar, separados por
# vírgula (IDs "UC…"): UCxxxxxxxxxxxxxxxxxxxxxx,UCyyyyyyyyyyyyyyyyyyyyyy
# Vazio = provider desativado, nenhuma chamada ao YouTube.
#
# "embeddable" NÃO prova licença. Liste só canais que você verificou terem os
# direitos dos títulos completos — esta lista é decisão sua, não uma
# verificação automática de direitos autorais. Lida só no servidor.
# ---------------------------------------------------------------------------
YOUTUBE_ALLOWED_CHANNEL_IDS=

# ---------------------------------------------------------------------------
# Instâncias do PeerTube cujos vídeos o adaptador pode usar, separadas por
# vírgula (só o host): framatube.org,video.blender.org
# Vazio = adaptador do PeerTube desativado, nenhuma chamada ao PeerTube.
#
# Esta lista é decisão sua: só inclua instâncias em que você confia. Mesmo
# assim, o vídeo só toca se (1) um admin o associou a um título e marcou
# como VERIFIED e (2) ele é público, publicado, não é ao vivo e tem licença
# CC BY, CC BY-SA, CC BY-ND, domínio público ou "livre de restrições". A
# licença é declarada por quem enviou o vídeo — não prova titularidade.
# Lida só no servidor.
# ---------------------------------------------------------------------------
PEERTUBE_ALLOWED_INSTANCES=

# ---------------------------------------------------------------------------
# Servidores PRÓPRIOS ou LICENCIADOS (Xtream, M3U, arquivos, API REST).
# Lista JSON numa única linha. Vazio = nenhum servidor configurado. Lida só no
# servidor: usuário, senha e tokens NUNCA chegam ao navegador nem aos logs
# (o vídeo passa por /api/playback/proxy, criptografado e por usuário).
#
# Cada item precisa de: id (minúsculas, números e hífen; 2 a 30 caracteres;
# não pode ser archive/peertube/internet-archive/authorized/youtube), label,
# kind e licenseReference (o contrato/prova de direitos do acervo, mín. 10
# caracteres). Segredos aceitam "env:NOME" (lido de uma variável de ambiente;
# se faltar, o servidor é ignorado). Item inválido é ignorado com aviso no log.
#
# Isto NÃO libera nenhum título: a sincronização só gera SUGESTÕES. Um admin
# precisa aprovar cada título (ou lote) informando a licença que o cobre.
# Dica: "mediaOrigins" lista origens extras (CDNs) de onde a mídia pode vir;
# o conteúdo de playlists/APIs nunca decide sozinho para onde o backend conecta.
# O backend recusa endereços de rede privada/loopback/metadata (SSRF), a menos
# que o servidor seja SEU e esteja numa rede privada: "allowPrivateNetwork": true.
#
# Exemplo mínimo (sem segredos reais):
# PLAYBACK_SERVERS=[{"id":"meu-painel","label":"Meu painel","kind":"xtream","baseUrl":"https://painel.exemplo.com:8443","username":"env:PAINEL_USER","password":"env:PAINEL_PASS","licenseReference":"Contrato 123/2026 com o distribuidor X"}]
#
# Outros tipos (campos extras):
#   m3u   -> "playlistUrl" (+ "auth", "mediaOrigins")
#   files -> "baseUrl" https (+ "auth", "proxy": true); assetId = caminho relativo
#   rest  -> "baseUrl" https, "assetPath":"/v1/videos/{assetId}", "urlPath":"playback.url"
#            (+ "typePath", "mediaNeedsAuth", "mediaOrigins", "searchPath", "itemsPath",
#             "idPath", "titlePath", "yearPath", "tmdbPath", "imdbPath")
#   auth  -> {"type":"none"} | {"type":"bearer","token":"env:T"} |
#            {"type":"header","name":"X-Api-Key","value":"env:K"} |
#            {"type":"query","name":"api_key","value":"env:K"} |
#            {"type":"basic","username":"env:U","password":"env:P"}
# ---------------------------------------------------------------------------
PLAYBACK_SERVERS=

# ---------------------------------------------------------------------------
# Disponibilidade dos vídeos. Um título só mostra "tem vídeo" nos cards
# quando uma associação VERIFIED foi conferida no provedor (AVAILABLE) há no
# máximo este número de horas; mais velha que isso vira "desconhecida" até a
# próxima verificação. Vazio = 48.
# ---------------------------------------------------------------------------
PLAYBACK_AVAILABILITY_FRESH_HOURS=

# ---------------------------------------------------------------------------
# Reverificação periódica (POST /api/internal/reverify, chamada pelo workflow
# .github/workflows/playback-reverify.yml a cada 6 h; até 8 chamadas de 25 por
# execução = 200 associações por execução, 800 por dia — mantenha o catálogo
# dentro dessa capacidade ou títulos voltam a "Em breve" após a janela de
# PLAYBACK_AVAILABILITY_FRESH_HOURS). Segredo longo e
# aleatório (openssl rand -base64 32); o MESMO valor vai no secret CRON_SECRET
# do GitHub. Vazio = endpoint desativado (responde 404). Lido só no servidor.
# ---------------------------------------------------------------------------
CRON_SECRET=
